<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#121212">

    <!-- Balance Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#3652BA"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Balance"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹0.00"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Income"
                    android:textColor="#CCCCCC"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/widget_income"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0.00"
                    android:textColor="#4CAF50"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expenses"
                    android:textColor="#CCCCCC"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/widget_expenses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0.00"
                    android:textColor="#FF6B6B"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Entries Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quick Entries"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp" />

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1E1E1E"
        android:layout_marginBottom="8dp"
        android:padding="2dp">

        <TextView
            android:id="@+id/tab_daily"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  Daily  "
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:padding="6dp"
            android:background="#3652BA" />

        <TextView
            android:id="@+id/tab_monthly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Monthly "
            android:textColor="#888888"
            android:textSize="11sp"
            android:padding="6dp" />

        <TextView
            android:id="@+id/tab_flexi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  Flexi  "
            android:textColor="#888888"
            android:textSize="11sp"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/quick_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—"
            android:textColor="#E0E0E0"
            android:textSize="11sp"
            android:gravity="center"
            android:padding="10dp"
            android:background="#1E1E1E"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/quick_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—"
            android:textColor="#E0E0E0"
            android:textSize="11sp"
            android:gravity="center"
            android:padding="10dp"
            android:background="#1E1E1E"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/quick_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—"
            android:textColor="#E0E0E0"
            android:textSize="11sp"
            android:gravity="center"
            android:padding="10dp"
            android:background="#1E1E1E" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/quick_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—"
            android:textColor="#E0E0E0"
            android:textSize="11sp"
            android:gravity="center"
            android:padding="10dp"
            android:background="#1E1E1E"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/quick_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—"
            android:textColor="#E0E0E0"
            android:textSize="11sp"
            android:gravity="center"
            android:padding="10dp"
            android:background="#1E1E1E"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/quick_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—"
            android:textColor="#E0E0E0"
            android:textSize="11sp"
            android:gravity="center"
            android:padding="10dp"
            android:background="#1E1E1E" />
    </LinearLayout>

</LinearLayout>
